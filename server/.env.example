PORT=3001
NODE_ENV=development
CLIENT_URL=https://app.boxsbeyond.com
ADMIN_URL=https://admin.boxsbeyond.com

# Public URLs — used by the API docs page and by webhook payloads.
# PUBLIC_API_URL is the host sellers actually call. It MUST be the real API
# origin: it becomes the base URL and every curl sample on /docs. If unset it
# falls back to PUBLIC_SITE_URL + /api.
PUBLIC_API_URL=https://api.boxsbeyond.com
# Marketing/app site. Used to build the `tracking_url` sent on every webhook.
PUBLIC_SITE_URL=https://boxsbeyond.com

# Postgres (Drizzle ORM)
DATABASE_URL=postgres://user:pass@localhost:5432/box_and_beyond

# Auth — JWT
JWT_SECRET=                         # Required: long random string (e.g. openssl rand -hex 32)
ACCESS_TOKEN_EXPIRES_IN=15m         # JWT access token lifetime (default: 15m)
REFRESH_TOKEN_EXPIRES_DAYS=7        # Refresh token / cookie lifetime in days (default: 7)

# Auth — OTP
OTP_EXPIRES_MINUTES=10              # OTP code validity in minutes (default: 10)
OTP_MAX_ATTEMPTS=3                  # Max wrong-code attempts before OTP is invalidated (default: 3)

# Auth — Security
BCRYPT_ROUNDS=12                    # bcrypt hash rounds (default: 12)

# Rate limiting
RATE_LIMIT_OTP_WINDOW_MS=900000     # OTP rate-limit window in ms — 900000 = 15 min (default: 15 min)
RATE_LIMIT_OTP_MAX=5                # Max OTP sends per window per IP (default: 5)
RATE_LIMIT_LOGIN_WINDOW_MS=900000   # Login rate-limit window in ms — 900000 = 15 min (default: 15 min)
RATE_LIMIT_LOGIN_MAX=10             # Max login attempts per window per IP (default: 10)

# Auth — Email OTP (optional in dev — OTP printed to console if not set)
# SMTP is preferred when configured. Use Gmail app passwords or any SMTP relay.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
EMAIL_FROM=noreply@boxandbeyond.com
EMAIL_FROM_NAME=Box and Beyond

# Google OAuth (optional — Google button disabled in client if not set)
# GOOGLE_CLIENT_ID=

# Razorpay (wallet recharge)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# S3-compatible storage (Cloudflare R2 / AWS S3 / MinIO)
# Used for KYC documents, label logos, shipping labels, invoices, manifests,
# billing invoice PDFs/CSVs, exports, support attachments and blog media.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=shipzilla-prod
S3_KEY_PREFIX=boxandbeyond

# Delhivery
DELHIVERY_TOKEN=
# DELHIVERY_RATE_URL=https://track.delhivery.com/api/kinko/v1/invoice/charges/

# DTDC
# Optional shared token for the DTDC push endpoint (POST /courier-webhooks/dtdc).
# If set, DTDC must send it (x-access-token / authorization / api-key / token
# header, or ?token= query). If unset, the push endpoint accepts unauthenticated
# posts (logged). DTDC per-account booking/tracking creds live in the admin UI
# (service_providers.credentials), not here.
DTDC_PUSH_TOKEN=

# Metrics scrape token (Prometheus)
METRICS_TOKEN=
