{
  "name": "box-and-beyond",
  "private": true,
  "description": "Box and Beyond - courier aggregator platform",
  "scripts": {
    "dev:landing": "npm run dev --workspace=landing",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=server"
  },
  "workspaces": [
    "landing",
    "server",
    "client",
    "admin"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
